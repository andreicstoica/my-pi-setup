{
  "private": true,
  "workspaces": [
    "extensions/ask-user",
    "extensions/background-terminals",
    "extensions/copy-all",
    "extensions/file-search",
    "extensions/git-info",
    "extensions/model-info",
    "extensions/polish",
    "extensions/subagents",
    "extensions/todo",
    "extensions/ui-customization",
    "extensions/web"
  ],
  "dependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "acorn": "^8.17.0",
    "firecrawl": "^4.30.0",
    "typebox": "^1.3.6"
  },
  "devDependencies": {
    "@effect/tsgo": "^0.55.0",
    "@types/node": "^26.1.1",
    "prettier": "^3.9.5",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "format": "prettier --write \"extensions/**/*.{ts,cjs}\" \"*.json\"",
    "format:check": "prettier --check \"extensions/**/*.{ts,cjs}\" \"*.json\"",
    "test": "node --test --experimental-strip-types extensions/*/*.test.ts && npm --prefix extensions/file-search test",
    "smoke": "node scripts/settings-sanity.mjs && npm --prefix extensions/subagents run test:live",
    "prepare": "effect-tsgo patch"
  },
  "overrides": {
    "undici": "8.12.3"
  }
}
